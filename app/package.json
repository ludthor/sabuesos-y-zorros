{
  "name": "sabuesos-y-zorros-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @syz/server",
    "build": "npm run build -w @syz/client",
    "start": "npm run start -w @syz/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine && tsc -p packages/protocol && tsc -p packages/server && tsc -p packages/client"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
